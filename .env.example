# העתק לקובץ .env.local לפיתוח מקומי.
# ב-Vercel: Settings > Environment Variables > Import .env
# סמן Production, Preview ו-Development, ואז Redeploy.
#
# מפתחות GNews הם לשרת בלבד — בלי קידומת NEXT_PUBLIC_.

GNEWS_API_KEY=
GNEWS_API_KEY_FALLBACK=

# כתובת ציבורית עם https. אחרי הפריסה אפשר למלא למשל:
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# אם ריק, האתר משתמש אוטומטית בכתובת https של Vercel.
NEXT_PUBLIC_SITE_URL=
